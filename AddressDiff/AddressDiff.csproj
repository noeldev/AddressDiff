<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>AddressDiff</RootNamespace>
		<AssemblyName>AddressDiff</AssemblyName>
		<Version>1.1.0</Version>
		<Product>AddressDiff</Product>
		<Authors>Noël Danjou</Authors>
		<Company>Noël Danjou EI</Company>
		<Description>Cross-check OpenStreetMap addresses against the French Base Adresse Nationale (BAN)</Description>
		<Copyright>Copyright (C) 2026 Noël Danjou</Copyright>
	</PropertyGroup>

	<ItemGroup>
		<AssemblyMetadata Include="License" Value="GPL-3.0-or-later" />
	</ItemGroup>

</Project>
